# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
*.key

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Generated outputs ────────────────────────────────────────────────────────
# Rasters, tables and intermediate artefacts are regenerable and stay out.
# The paper's figures and its machine-readable number tables are tracked:
# data/*.tif is excluded (297 MB), so a fresh clone CANNOT regenerate them and
# without these the repository would show no results at all.
outputs/*
!outputs/figures/
!outputs/paper/
# Validation: the small, citable outputs are tracked; the 25 MB point tables
# are regenerable with tools/validate_mgnrega.py.
!outputs/validation/
outputs/validation/validation_points.csv
outputs/validation/validation_criteria.csv
*.log

# ── Data ─────────────────────────────────────────────────────────────────────
# Source rasters/vectors are large. Keep them out of git and document how to
# regenerate them from QGIS (see README.md).  Delete these three lines if you
# decide the ~50 MB of layers should be versioned with the code.
data/*.tif
data/*.tif.aux.xml
data/*.shp
data/*.shx
data/*.dbf
data/*.prj
data/*.cpg
data/*.qmd
!data/boundary.geojson
!data/rivers.geojson

# MGNREGA raw geotag responses: they contain observer names (personal data)
# and are re-pullable with tools/pull_mgnrega.py. PROVENANCE.md,
# dropdown_codes.tsv and category_codes.csv stay tracked.
data/raw/mgnrega/*.json
data/raw/mgnrega/stage*/*.json

# Statewide downloads (31 MB), re-downloadable; see data/raw/talukas/PROVENANCE.md.
# The small Chandrapur extracts beside them stay tracked.
data/raw/talukas/MAHARASHTRA_*.geojson

# MGNREGA field photos for the audit: they may show people.
reports/photo_audit/

# CGWB report PDF (13 MB, public, re-downloadable; see data/raw/cgwb/PROVENANCE.md)
data/raw/cgwb/*.pdf
data/raw/gsda/*.pdf
